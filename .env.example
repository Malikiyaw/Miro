# ─── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here

# Optional proxy for the Discord gateway/HTTP (useful on hosts with blocked IPs)
# DISCORD_PROXY=http://user:pass@host:port
# HTTP_PROXY=
# HTTPS_PROXY=

# Port for the health endpoint Render polls (default: 10000)
PORT=10000

# Sync application (slash) commands on startup
SYNC_COMMANDS=false

# Encryption key for stored per-guild API keys (auto-generated in data/.encryption_key if unset)
# ENCRYPTION_KEY=your_encryption_key_here

# ─── AI Configuration ───────────────────────────────────────────────────────
AI_API_KEY=your_ai_api_key_here
AI_PROVIDER=openrouter
AI_MODEL=microsoft/wizardlm-2-8x22b

# Optional web search for the AI agent (Tavily)
# TAVILY_API_KEY=your_tavily_key_here

# Optional per-provider overrides (OpenAI-compatible endpoints)
# OPENROUTER_URL=  OPENAI_URL=  GEMINI_URL=  ANTHROPIC_URL=  GROQ_URL=
# MISTRAL_URL=     DEEPSEEK_URL=  DASHSCOPE_URL=  CEREBRAS_URL=
# SAMBANOVA_URL=   TOGETHER_URL=

# ─── Memory ─────────────────────────────────────────────────────────────────
# Verbatim memory + summarization
# RECENT_MEMORY_DEPTH = how many recent exchanges are kept verbatim per user
#   (50 exchanges = 100 messages). Previously 10 → only 20 messages survived.
#   Aligned with MEMORY_DEPTH so a memory_depth=100 conversation never loses
#   verbatim messages to summarization.
# SUMMARY_THRESHOLD = total exchanges before oldest are summarized (was 50 → churn)
RECENT_MEMORY_DEPTH=50
SUMMARY_THRESHOLD=100
MAX_SUMMARY_AGE_DAYS=30

# Per-request context depth injected into every AI prompt
# Per-guild ai_config.memory_depth overrides this. Use /config depth to change
# per-server without restarting. Env default is 100 exchanges (200 messages).
MEMORY_DEPTH=100

# Semantic recall via ChromaDB (falls back to keyword search when unset)
# Vector memory is now READ in ai_client.py (was write-only). Set results=0 to disable.
# CHROMA_HOST=
# CHROMA_PORT=
VECTOR_MEMORY_RESULTS=5
VECTOR_MEMORY_MIN_IMPORTANCE=0.3
